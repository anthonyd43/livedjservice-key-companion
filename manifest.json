{
  "manifest_version": 3,
  "name": "Camelot Key Companion for LiveDJService",
  "version": "1.0.0",
  "description": "Shows the musical key (Mixed In Key style) next to every Camelot code on livedjservice.com.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://livedjservice.com/*", "*://*.livedjservice.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
